rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCalendarConfig(data) {
      return data.keys().hasOnly(['customHolidays', 'specialMeetings', 'sessionClosingDate', 'updatedAt'])
        && (!('customHolidays' in data) || data.customHolidays is map)
        && (!('specialMeetings' in data) || data.specialMeetings is map)
        && (!('sessionClosingDate' in data) || (data.sessionClosingDate is string && data.sessionClosingDate.size() <= 30))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /calendar_config/{configId} {
      allow get, list: if isValidId(configId);
      allow create, update: if isValidId(configId) && isValidCalendarConfig(request.resource.data);
      allow delete: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
